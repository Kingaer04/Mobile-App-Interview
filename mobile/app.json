{
  "expo": {
    "name": "Citizen Reports",
    "slug": "citizen-reports",
    "scheme": "citizenreports",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citizenreports.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.citizenreports.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#D7263D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Citizen Reports uses your location to tag where an incident happened."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Citizen Reports needs access to your photos so you can attach pictures of an incident.",
          "cameraPermission": "Citizen Reports needs the camera so you can take pictures of an incident."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D7263D"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": ""
    }
  }
}
